<%- include('partials/header') %>

    <div class="row justify-content-center py-5">
        <div class="col-md-5">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-dark text-white p-4 border-0">
                    <h4 class="mb-0 fw-bold"><i class="fas fa-user-shield me-2"></i>Account Recovery</h4>
                    <p class="mb-0 small opacity-75">Enter your email to reset password</p>
                </div>
                <div class="card-body p-4">
                    <% if (typeof error !=='undefined' && error) { %>
                        <div class="alert alert-danger border-0 small shadow-sm mb-4">
                            <i class="fas fa-exclamation-circle me-2"></i>
                            <%= error %>
                        </div>
                        <% } %>

                            <form action="/auth/forgot-password" method="POST">
                                <div class="mb-4">
                                    <label class="form-label small fw-bold text-muted text-uppercase">Institutional
                                        Email</label>
                                    <div class="input-group shadow-sm">
                                        <span class="input-group-text bg-light border-0"><i
                                                class="fas fa-envelope text-muted"></i></span>
                                        <input type="email" class="form-control bg-light border-0" name="email"
                                            placeholder="user@gcet.edu.in" required>
                                    </div>
                                    <small class="text-muted mt-2 d-block">A recovery link will be sent to your GCET
                                        email.</small>
                                </div>

                                <button type="submit"
                                    class="btn btn-dark w-100 py-3 fw-bold shadow-sm rounded-pill">Continue</button>
                            </form>
                </div>
                <div class="card-footer bg-light border-0 text-center py-3">
                    <a href="/login" class="text-dark small text-decoration-none fw-bold"><i
                            class="fas fa-arrow-left me-1"></i> Back to Login</a>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>