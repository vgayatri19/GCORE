<%- include('partials/header') %>

    <!-- Hero Section -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="premium-card hero-gradient overflow-hidden position-relative" style="min-height: 450px;">
                <div class="card-body p-lg-5 p-4 d-flex flex-column justify-content-center z-1 position-relative">
                    <div class="col-lg-8 animate-fade-in">
                        <span class="badge glass-card text-white px-3 py-2 mb-4">
                            <i class="fas fa-sparkles text-warning me-2"></i>Institutional Excellence
                        </span>
                        <h1 class="display-2 fw-800 text-white mb-3">The Future of <br><span
                                class="text-warning">Institutional</span> Management</h1>
                        <p class="lead text-white opacity-75 mb-5 fs-4">GCORE provides a unified, secure, and
                            intelligent platform for managing academics, careers, and campus culture.</p>
                        <div class="d-flex flex-wrap gap-3">
                            <a href="/departments" class="btn btn-premium btn-light shadow-lg">
                                <i class="fas fa-compass me-2"></i>Explore Campus
                            </a>
                            <a href="/auth/register" class="btn btn-premium btn-outline-light">
                                Get Started <i class="fas fa-arrow-right ms-2 small"></i>
                            </a>
                        </div>
                    </div>
                </div>
                <!-- Abstract Design Elements -->
                <div class="position-absolute bottom-0 end-0 opacity-05 mb-n5 me-n5 rotate-15 d-none d-lg-block"
                    style="z-index: 0;">
                    <i class="fas fa-university fa-25x text-white"></i>
                </div>
                <div class="position-absolute bottom-0 start-0 w-100 h-25"
                    style="background: linear-gradient(to top, rgba(0,0,0,0.1), transparent); z-index: 0;"></div>
            </div>
        </div>
    </div>

    <!-- Core Feature Tiles -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="premium-card p-4 h-100 bg-brand text-white">
                <div
                    class="bg-white bg-opacity-10 rounded-circle d-inline-flex p-3 mb-4 border border-white border-opacity-10">
                    <i class="fas fa-graduation-cap fa-2x"></i>
                </div>
                <h4 class="fw-bold">Academics</h4>
                <p class="small opacity-75 mb-4">Deep dive into departmental curricula, outcomes, and faculty expertise.
                </p>
                <a href="/departments" class="text-warning text-decoration-none fw-bold small">View Departments <i
                        class="fas fa-chevron-right ms-1"></i></a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="premium-card p-4 h-100">
                <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex p-3 mb-4 text-primary">
                    <i class="fas fa-briefcase fa-2x"></i>
                </div>
                <h4 class="fw-bold">Career Center</h4>
                <p class="text-secondary small mb-4">Launch your professional journey with exclusive placement drives
                    and mentorship.</p>
                <a href="/placements" class="text-primary text-decoration-none fw-bold small">Manage Placements <i
                        class="fas fa-chevron-right ms-1"></i></a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="premium-card p-4 h-100">
                <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex p-3 mb-4 text-success">
                    <i class="fas fa-users fa-2x"></i>
                </div>
                <h4 class="fw-bold">Pulse Community</h4>
                <p class="text-secondary small mb-4">Engage with student-led organizations and shape the campus culture
                    together.</p>
                <a href="/clubs" class="text-success text-decoration-none fw-bold small">Discover Clubs <i
                        class="fas fa-chevron-right ms-1"></i></a>
            </div>
        </div>
    </div>

    <!-- Split View: Events & Calendar -->
    <div class="row g-5 mb-5 align-items-start">
        <div class="col-lg-4">
            <div class="sticky-top" style="top: 100px;">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="fw-bold text-dark mb-0">Today's Pulse</h3>
                    <div class="rounded-pill bg-danger bg-opacity-10 px-3 py-1 text-danger small fw-bold">
                        <i class="fas fa-circle-dot animate-pulse me-1"></i> Live
                    </div>
                </div>

                <% if (todaysEvents && todaysEvents.length> 0) { %>
                    <div class="d-grid gap-3">
                        <% todaysEvents.forEach(event=> { %>
                            <div class="premium-card p-4 border-start border-4 border-primary">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="badge bg-light text-primary border px-2 py-1 small">
                                        <%= event.type %>
                                    </span>
                                    <span class="small text-muted fw-bold"><i class="fas fa-clock me-1"></i>Now</span>
                                </div>
                                <h5 class="fw-bold mb-3">
                                    <%= event.title %>
                                </h5>
                                <div class="d-flex align-items-center text-muted small">
                                    <i class="fas fa-map-marker-alt me-2"></i>
                                    <%= event.location %>
                                </div>
                            </div>
                            <% }) %>
                    </div>
                    <% } else { %>
                        <div class="premium-card p-5 text-center bg-light bg-opacity-50">
                            <div class="bg-white rounded-circle d-inline-flex p-4 shadow-sm mb-3">
                                <i class="fas fa-mug-hot fa-2x text-muted opacity-50"></i>
                            </div>
                            <p class="text-muted small mb-0">The campus is relaxing today. Check back for upcoming buzz!
                            </p>
                        </div>
                        <% } %>

                            <!-- Quick Guides -->
                            <div class="mt-5">
                                <h6 class="text-muted text-uppercase fw-800 small mb-4">Pro Services</h6>
                                <div class="premium-card p-3 mb-2 d-flex align-items-center">
                                    <div class="p-2 bg-info bg-opacity-10 text-info rounded-3 me-3"><i
                                            class="fas fa-file-invoice"></i></div>
                                    <a href="/placements" class="text-dark text-decoration-none fw-bold small">ATS Score
                                        Review</a>
                                </div>
                                <div class="premium-card p-3 d-flex align-items-center">
                                    <div class="p-2 bg-warning bg-opacity-10 text-warning rounded-3 me-3"><i
                                            class="fas fa-chalkboard-user"></i></div>
                                    <a href="/placements" class="text-dark text-decoration-none fw-bold small">Interview
                                        Simulator</a>
                                </div>
                            </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="fw-bold text-dark mb-0">Strategic Calendar</h3>
                <span class="text-muted small fw-bold">
                    <%= events.length %> Activities Planned
                </span>
            </div>

            <div class="premium-card overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light border-0">
                            <tr class="text-muted small fw-bold">
                                <th class="ps-4 py-3 border-0">TIMELINE</th>
                                <th class="py-3 border-0">EVENT SCOPE</th>
                                <th class="py-3 border-0">LOCATION</th>
                                <th class="pe-4 py-3 border-0 text-end">FACILITATOR</th>
                            </tr>
                        </thead>
                        <tbody class="border-0">
                            <% events.forEach(event=> { %>
                                <tr class="cursor-pointer border-0">
                                    <td class="ps-4 py-4 border-0">
                                        <div class="d-flex align-items-center">
                                            <div class="text-center rounded-3 p-2 me-3"
                                                style="min-width: 60px; background: rgba(2, 24, 73, 0.05);">
                                                <div class="small fw-bold text-brand" style="font-size: 0.6rem;">
                                                    <%= new Date(event.date).toLocaleString('default', { month: 'short'
                                                        }).toUpperCase() %>
                                                </div>
                                                <div class="h5 mb-0 fw-800">
                                                    <%= new Date(event.date).getDate() %>
                                                </div>
                                            </div>
                                            <div class="small fw-bold text-muted">
                                                <%= new Date(event.date).toLocaleTimeString([], {hour: '2-digit' ,
                                                    minute:'2-digit'}) %>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-4 border-0">
                                        <div class="fw-bold text-dark mb-1">
                                            <%= event.title %>
                                        </div>
                                        <div class="small text-muted line-clamp-1">
                                            <%= event.description %>
                                        </div>
                                    </td>
                                    <td class="py-4 border-0">
                                        <span class="small text-secondary"><i
                                                class="fas fa-location-dot me-2 text-primary"></i>
                                            <%= event.location %>
                                        </span>
                                    </td>
                                    <td class="pe-4 py-4 border-0 text-end">
                                        <span class="badge bg-brand text-white rounded-pill px-3 py-1 fw-normal">
                                            <%= event.department %>
                                        </span>
                                    </td>
                                </tr>
                                <% }) %>
                                    <% if (events.length===0) { %>
                                        <tr>
                                            <td colspan="4" class="text-center py-5 border-0 bg-light bg-opacity-25">
                                                <p class="text-muted mb-0">No upcoming events are currently scheduled.
                                                </p>
                                            </td>
                                        </tr>
                                        <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <style>
        .animate-fade-in {
            animation: fadeIn 1s ease-out;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .animate-pulse {
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% {
                transform: scale(0.95);
                opacity: 0.8;
            }

            70% {
                transform: scale(1.1);
                opacity: 1;
            }

            100% {
                transform: scale(0.95);
                opacity: 0.8;
            }
        }

        .fw-800 {
            font-weight: 800;
        }

        .fa-25x {
            font-size: 25rem;
        }

        .line-clamp-1 {
            display: -webkit-box;
            -webkit-line-clamp: 1;
            line-clamp: 1;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
    </style>

    <%- include('partials/footer') %>