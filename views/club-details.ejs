<%- include('partials/header') %>

    <div class="club-hero py-5 mb-5" style="background: linear-gradient(135deg, #021849 0%, #052c7a 100%);">
        <div class="container py-4">
            <div class="row align-items-center">
                <div class="col-md-2 text-center text-md-start mb-4 mb-md-0">
                    <div
                        class="club-icon-wrapper rounded-circle bg-white bg-opacity-10 d-inline-flex p-4 shadow-lg border border-white border-opacity-10">
                        <i class="fas fa-<%= club.icon %> fa-4x text-white"></i>
                    </div>
                </div>
                <div class="col-md-7 text-center text-md-start text-white">
                    <span
                        class="badge bg-white bg-opacity-20 text-white border border-white border-opacity-10 px-3 py-2 mb-3 shadow-sm rounded-pill">
                        <i class="fas fa-shield-alt text-warning me-2 small"></i>🛡️ Verified Club | CSE Department
                    </span>
                    <h1 class="display-3 fw-bold mb-2">
                        <%= club.name %>
                    </h1>
                    <p class="lead opacity-75 mb-3">
                        <%= club.description %>
                    </p>
                    <div class="d-flex flex-wrap gap-4 justify-content-center justify-content-md-start mb-0">
                        <div class="d-flex align-items-center">
                            <h4 class="fw-bold mb-0 me-2"><%= club.members || '140' %>+</h4>
                            <span class="small opacity-75">Members</span>
                        </div>
                        <div class="d-flex align-items-center border-start border-white border-opacity-25 ps-4">
                            <h4 class="fw-bold mb-0 me-2">25+</h4>
                            <span class="small opacity-75">Events</span>
                        </div>
                        <div class="d-flex align-items-center border-start border-white border-opacity-25 ps-4">
                            <h4 class="fw-bold mb-0 me-2">10+</h4>
                            <span class="small opacity-75">CTF Wins</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 text-center text-md-end mt-4 mt-md-0">
                    <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
                        <a href="/admin/club/<%= club._id %>" class="btn btn-warning btn-lg px-4 py-3 rounded-pill fw-bold shadow-lg w-100 mb-2">
                            <i class="fas fa-cog me-2"></i>Manage Club
                        </a>
                        <small class="text-white-50 d-block">Admin Access</small>
                    <% } else if (typeof user !== 'undefined' && user && user.clubStatus === 'Pending') { %>
                        <button class="btn btn-secondary btn-lg px-4 py-3 rounded-pill fw-bold shadow-lg w-100 mb-2" disabled>
                            <i class="fas fa-hourglass-half me-2"></i>Status: Pending
                        </button>
                        <small class="text-white-50 d-block" style="font-size: 0.75rem;">Awaiting Approval</small>
                    <% } else { %>
                        <button class="btn btn-light btn-lg px-4 py-3 rounded-pill fw-bold shadow-lg w-100 mb-2">
                            <i class="fas fa-user-plus me-2"></i>Apply to Join <i class="fas fa-arrow-right ms-1"></i>
                        </button>
                        <small class="text-white-50 d-block" style="font-size: 0.75rem;">Approval by Club President & Faculty Coordinator</small>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <div class="container pb-5">
        <div class="row g-4">
            <!-- Left Column: Core Info -->
            <div class="col-lg-8">
                <div class="row g-4">
                    <div class="col-12">
                        <div class="card border-0 shadow-sm rounded-4 h-100 p-4 detail-card">
                            <h5 class="fw-bold mb-3 text-dark"><i class="fas fa-info-circle text-primary me-2"></i>About the Club</h5>
                            <p class="text-secondary small mb-4">
                                <%= club.vision %> <%= club.mission %>
                            </p>
                            
                            <h6 class="fw-bold mb-2 small text-uppercase text-muted">Focus Areas</h6>
                            <div class="d-flex flex-wrap gap-2 mb-4">
                                <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">CTF</span>
                                <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">Ethical Hacking</span>
                                <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">Network Security</span>
                            </div>

                            <h6 class="fw-bold mb-2 small text-uppercase text-muted">Recent Achievements</h6>
                            <ul class="list-unstyled mb-0 text-secondary small">
                                <li class="mb-2"><i class="fas fa-trophy text-warning me-2"></i>2nd place in Chakravyuh 2.0 (National Level)</li>
                                <li><i class="fas fa-star text-warning me-2"></i>Hosted 5+ successful security workshops this semester</li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="card border-0 shadow-sm rounded-4 p-4 detail-card">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h5 class="fw-bold mb-0 text-dark"><i class="fas fa-calendar-alt text-success me-2"></i>Upcoming & Active Events</h5>
                            </div>

                            <% 
                               const todayEvent = new Date();
                               todayEvent.setHours(0,0,0,0);
                               const approvedEvents = events ? events.filter(e => e.approvalStatus === 'Approved') : [];
                               const upcomingEvts = approvedEvents.filter(e => e.status !== 'Completed' && new Date(e.date) >= todayEvent);
                               const pastEvts = approvedEvents.filter(e => e.status === 'Completed' || new Date(e.date) < todayEvent);
                               const isClubMember = typeof user !== 'undefined' && user && (user.role === 'admin' || user.role === 'Admin' || user.clubStatus === 'Approved');
                            %>

                            <% if (upcomingEvts.length > 0) { %>
                                <div class="row g-3">
                                    <% upcomingEvts.forEach(event => { %>
                                            <div class="col-md-12">
                                                <div class="p-4 border rounded-4 bg-light bg-opacity-50 transition-hover">
                                                    <div class="row align-items-center">
                                                        <div class="col-md-8 mb-3 mb-md-0">
                                                            <div class="d-flex align-items-center mb-2">
                                                                <h6 class="fw-bold mb-0 text-primary me-2">
                                                                    <%= event.title %>
                                                                </h6>
                                                                <span class="badge bg-success px-2 pb-1" style="font-size: 0.65rem;">
                                                                    Upcoming
                                                                </span>
                                                            </div>
                                                            <p class="small text-secondary mb-3 text-truncate">
                                                                <%= event.description || 'Join us for this amazing event!' %>
                                                            </p>
                                                            <div class="d-flex gap-4 small text-muted">
                                                                <span><i class="fas fa-clock me-1"></i>
                                                                    <%= new Date(event.date).toLocaleDateString() %>
                                                                </span>
                                                                <span><i class="fas fa-map-marker-alt me-1"></i>
                                                                    <%= event.location || 'College Campus' %>
                                                                </span>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-4 text-md-end">
                                                            <button class="btn btn-sm btn-primary rounded-pill px-4 mb-2 w-100 w-md-auto shadow-sm">Register</button>
                                                            <button class="btn btn-sm btn-outline-secondary rounded-pill px-4 w-100 w-md-auto">Details</button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                    <% }) %>
                                </div>
                                <% } else { %>
                                    <div class="text-center py-5 bg-light rounded-4 border border-dashed">
                                        <div class="mb-3 d-inline-block p-3 bg-white rounded-circle shadow-sm">
                                            <i class="fas fa-calendar-times fa-2x text-primary opacity-75"></i>
                                        </div>
                                        <h6 class="fw-bold text-dark">No upcoming events</h6>
                                        <p class="text-muted small mb-0">Stay tuned for future announcements.</p>
                                    </div>
                                <% } %>
                        </div>
                    </div>

                    <!-- Past Events Section -->
                    <div class="col-12">
                        <div class="card border-0 shadow-sm rounded-4 p-4 detail-card">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h5 class="fw-bold mb-0 text-dark"><i class="fas fa-history text-secondary me-2"></i>Past Events & Reports</h5>
                                <% if (isClubMember) { %>
                                    <button class="btn btn-sm btn-outline-primary rounded-pill" data-bs-toggle="modal" data-bs-target="#addPastEventModal">
                                        <i class="fas fa-plus me-1"></i> Add Past Event
                                    </button>
                                <% } %>
                            </div>

                            <% if (pastEvts.length > 0) { %>
                                <div class="row g-3">
                                    <% pastEvts.forEach(event => { %>
                                            <div class="col-md-12">
                                                <div class="p-4 border rounded-4 bg-light bg-opacity-50 transition-hover">
                                                    <div class="row align-items-center">
                                                        <div class="col-md-8 mb-3 mb-md-0">
                                                            <div class="d-flex align-items-center mb-2">
                                                                <h6 class="fw-bold mb-0 text-dark me-2">
                                                                    <%= event.title %>
                                                                </h6>
                                                                <span class="badge bg-secondary px-2 pb-1" style="font-size: 0.65rem;">
                                                                    Completed
                                                                </span>
                                                            </div>
                                                            <p class="small text-secondary mb-3 text-truncate">
                                                                <%= event.description || 'A successful past event.' %>
                                                            </p>
                                                            <div class="d-flex gap-4 small text-muted">
                                                                <span><i class="fas fa-calendar-check me-1"></i>
                                                                    <%= new Date(event.date).toLocaleDateString() %>
                                                                </span>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-4 text-md-end">
                                                            <% if (event.reportUrl) { %>
                                                                <% if (isClubMember) { %>
                                                                    <a href="<%= event.reportUrl %>" target="_blank" class="btn btn-sm btn-success rounded-pill px-4 w-100 w-md-auto shadow-sm">
                                                                        <i class="fas fa-file-alt me-1"></i> View Report
                                                                    </a>
                                                                <% } else { %>
                                                                    <span class="badge bg-light text-muted border px-3 py-2 rounded-pill"><i class="fas fa-lock me-1"></i> Members Only</span>
                                                                <% } %>
                                                            <% } else { %>
                                                                <span class="small text-muted fst-italic">No report uploaded</span>
                                                            <% } %>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                    <% }) %>
                                </div>
                            <% } else { %>
                                <div class="text-center py-4 bg-light rounded-4 border border-dashed">
                                    <div class="mb-2 d-inline-block p-2 bg-white rounded-circle shadow-sm">
                                        <i class="fas fa-archive fa-lg text-secondary opacity-75"></i>
                                    </div>
                                    <p class="text-muted small mb-0">No past events found.</p>
                                </div>
                            <% } %>
                        </div>
                        </div>
                    </div>
                </div>
                
                <!-- New Governance Workflow Section -->
                <div class="card border-0 shadow-sm rounded-4 p-4 mt-4 detail-card" style="background: linear-gradient(to right, #f8f9fa, #ffffff);">
                    <h5 class="fw-bold mb-4 text-dark"><i class="fas fa-project-diagram text-info me-2"></i>Governance Workflow</h5>
                    <div class="position-relative px-2">
                        <!-- Connecting Line -->
                        <div class="position-absolute top-50 start-0 w-100 border-top border-2 border-primary opacity-25" style="z-index: 0; transform: translateY(-50%);"></div>
                        
                        <div class="row text-center position-relative" style="z-index: 1;">
                            <div class="col-3">
                                <div class="bg-white border border-primary rounded-circle d-inline-flex justify-content-center align-items-center shadow-sm mb-2 workflow-node" style="width: 50px; height: 50px;">
                                    <i class="fas fa-user-graduate text-primary"></i>
                                </div>
                                <div class="small fw-bold text-dark">Student</div>
                                <div class="text-muted" style="font-size: 0.7rem;">Applies</div>
                            </div>
                            <div class="col-3">
                                <div class="bg-white border border-warning rounded-circle d-inline-flex justify-content-center align-items-center shadow-sm mb-2 workflow-node" style="width: 50px; height: 50px;">
                                    <i class="fas fa-users-cog text-warning"></i>
                                </div>
                                <div class="small fw-bold text-dark">Core Team</div>
                                <div class="text-muted" style="font-size: 0.7rem;">Reviews</div>
                            </div>
                            <div class="col-3">
                                <div class="bg-white border border-success rounded-circle d-inline-flex justify-content-center align-items-center shadow-sm mb-2 workflow-node" style="width: 50px; height: 50px;">
                                    <i class="fas fa-chalkboard-teacher text-success"></i>
                                </div>
                                <div class="small fw-bold text-dark">Faculty</div>
                                <div class="text-muted" style="font-size: 0.7rem;">Approves</div>
                            </div>
                            <div class="col-3">
                                <div class="bg-white border border-secondary rounded-circle d-inline-flex justify-content-center align-items-center shadow-sm mb-2 workflow-node" style="width: 50px; height: 50px;">
                                    <i class="fas fa-shield-alt text-secondary"></i>
                                </div>
                                <div class="small fw-bold text-dark">System</div>
                                <div class="text-muted" style="font-size: 0.7rem;">Grants Access</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Leadership & Stats -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                    <div class="card-header border-0 p-4" style="background: linear-gradient(135deg, #021849 0%, #052c7a 100%);">
                        <h5 class="mb-0 fw-bold text-white"><i class="fas fa-users-crown me-2"></i>Leadership</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="list-group list-group-flush rounded-bottom-4">
                            <div class="list-group-item p-3 border-0 border-bottom">
                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle bg-warning bg-opacity-10 text-warning d-flex justify-content-center align-items-center me-3 border border-warning" style="width: 48px; height: 48px;">
                                        <i class="fas fa-crown"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-0 fw-bold"><%= club.president || 'To be announced' %></h6>
                                        <small class="text-muted">President</small>
                                    </div>
                                </div>
                            </div>
                            <div class="list-group-item p-3 border-0 border-bottom">
                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle bg-secondary bg-opacity-10 text-secondary d-flex justify-content-center align-items-center me-3" style="width: 48px; height: 48px;">
                                        <span class="fw-bold"><%= club.vicePresident ? club.vicePresident.charAt(0) : 'V' %></span>
                                    </div>
                                    <div>
                                        <h6 class="mb-0 fw-bold"><%= club.vicePresident || 'To be announced' %></h6>
                                        <small class="text-muted">Vice President</small>
                                    </div>
                                </div>
                            </div>
                            <div class="list-group-item p-3 border-0">
                                <div class="d-flex align-items-center">
                                    <div class="position-relative me-3">
                                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex justify-content-center align-items-center" style="width: 48px; height: 48px;">
                                            <i class="fas fa-user-tie"></i>
                                        </div>
                                        <span class="position-absolute bottom-0 start-100 translate-middle p-1 bg-success border border-light rounded-circle" title="Verified Faculty">
                                            <span class="visually-hidden">Verified</span>
                                        </span>
                                    </div>
                                    <div>
                                        <h6 class="mb-0 fw-bold"><%= club.coordinator %></h6>
                                        <small class="text-muted">Faculty Coordinator <i class="fas fa-check-circle text-success ms-1 small"></i></small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 detail-card">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="fw-bold mb-0 text-dark"><i class="fas fa-chart-pie text-secondary me-2"></i>Club Analytics</h5>
                        <span class="badge bg-light text-dark border">YTD</span>
                    </div>
                    
                    <!-- Mock Growth Graph area -->
                    <div class="mb-4 bg-light rounded-3 d-flex align-items-end p-3" style="height: 100px;">
                        <div class="flex-grow-1 d-flex justify-content-between align-items-end h-100 px-2" style="gap: 4px;">
                            <div class="bg-primary bg-opacity-25 rounded-top w-100" style="height: 30%"></div>
                            <div class="bg-primary bg-opacity-50 rounded-top w-100" style="height: 45%"></div>
                            <div class="bg-primary bg-opacity-75 rounded-top w-100" style="height: 60%"></div>
                            <div class="bg-primary rounded-top w-100" style="height: 85%"></div>
                            <div class="bg-success rounded-top w-100 shadow-sm" style="height: 100%; position: relative;">
                                <span class="position-absolute top-0 start-50 translate-middle badge bg-dark rounded-pill" style="font-size: 0.6rem;">+12%</span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mb-3 pb-2 border-bottom">
                        <span class="text-muted small">Event Participation</span>
                        <span class="fw-bold text-success">86% <i class="fas fa-arrow-up ms-1 small"></i></span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 pb-2 border-bottom">
                        <span class="text-muted small">Active vs Inactive</span>
                        <div class="d-flex align-items-center gap-2">
                            <span class="fw-bold">120</span>
                            <div class="progress" style="width: 40px; height: 6px;">
                                <div class="progress-bar bg-success" role="progressbar" style="width: 85%"></div>
                            </div>
                            <span class="text-muted small">20</span>
                        </div>
                    </div>
                    <div class="d-flex flex-column gap-1">
                        <div class="d-flex justify-content-between">
                            <span class="text-muted small"><i class="fas fa-layer-group me-2"></i>Department</span>
                            <span class="fw-bold small px-2 py-1 bg-light rounded"><%= club.department %></span>
                        </div>
                        <div class="d-flex justify-content-between mt-2">
                            <span class="text-muted small"><i class="fas fa-shield-alt me-2"></i>Status</span>
                            <span class="badge bg-success-subtle text-success border border-success border-opacity-25">Active & Verified</span>
                        </div>
                    </div>
                </div>
                
                <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-danger text-white detail-card" style="background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);">
                    <h6 class="fw-bold mb-3"><i class="fas fa-bell me-2"></i>Join Requests Queue</h6>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span>Pending Approvals</span>
                        <span class="badge bg-white text-danger rounded-circle p-2 px-3 fs-6 shadow-sm">5</span>
                    </div>
                    <button class="btn btn-sm btn-outline-light rounded-pill w-100 mt-2 fw-bold">Review Requests</button>
                </div>
                <% } %>

                <div class="d-grid shadow-lg rounded-pill overflow-hidden">
                    <button class="btn btn-outline-dark p-3 fw-bold border-2">
                        <i class="fab fa-instagram me-2"></i>Follow on Social
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Add Past Event Modal -->
    <div class="modal fade" id="addPastEventModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow-lg">
                <div class="modal-header bg-dark text-white p-4 border-0">
                    <h5 class="modal-title fw-bold"><i class="fas fa-history me-2"></i>Add Past Event & Report</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form action="/clubs/<%= club.slug %>/past-events" method="POST" enctype="multipart/form-data">
                    <div class="modal-body p-4 bg-light bg-opacity-50">
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Event Title</label>
                            <input type="text" name="title" class="form-control border-0 shadow-sm" required>
                        </div>
                        <div class="row mb-3">
                            <div class="col-6">
                                <label class="form-label small fw-bold">Type</label>
                                <select name="type" class="form-select border-0 shadow-sm" required>
                                    <option value="Workshop">Workshop</option>
                                    <option value="Seminar">Seminar</option>
                                    <option value="Hackathon">Hackathon</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-bold">Date</label>
                                <input type="date" name="date" class="form-control border-0 shadow-sm" required>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Description Highlights</label>
                            <textarea name="description" class="form-control border-0 shadow-sm" rows="3" required></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Upload Report (PDF/Excel/CSV)</label>
                            <input type="file" name="reportFile" class="form-control border-0 shadow-sm" accept=".pdf,.doc,.docx,.xls,.xlsx,.csv" required>
                            <small class="text-muted mt-1 d-block"><i class="fas fa-cloud-upload-alt me-1"></i> File will be securely uploaded to cloud storage.</small>
                        </div>
                    </div>
                    <div class="modal-footer p-4 border-0">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-dark rounded-pill px-4">Upload Event</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <style>
        .club-hero {
            position: relative;
            overflow: hidden;
        }

        .club-hero::after {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 40%;
            height: 100%;
            background: linear-gradient(to left, rgba(255, 255, 255, 0.05), transparent);
            clip-path: polygon(100% 0, 0% 100%, 100% 100%);
        }

        .club-icon-wrapper {
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .detail-card {
            transition: transform 0.3s ease;
        }

        .detail-card:hover {
            transform: translateY(-5px);
        }

        .leader-item {
            transition: all 0.2s ease;
        }

        .leader-item:hover {
            background: #f8f9fa !important;
            transform: translateX(10px);
        }

        .transition-hover {
            transition: all 0.2s ease;
        }
        
        .transition-hover:hover {
            background-color: #fff !important;
            box-shadow: 0 .125rem .25rem rgba(0,0,0,.075);
            border-color: #dee2e6 !important;
        }

        .workflow-node {
            transition: transform 0.2s;
        }
        
        .workflow-node:hover {
            transform: scale(1.1);
        }
    </style>

    <%- include('partials/footer') %>