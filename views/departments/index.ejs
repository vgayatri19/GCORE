<%- include('../partials/header') %>

    <div class="row mb-5">
        <div class="col-12">
            <div class="premium-card hero-gradient overflow-hidden position-relative p-lg-5 p-4 text-white text-center"
                style="min-height: 250px;">
                <div class="z-1 position-relative py-3">
                    <h1 class="display-3 fw-800 mb-2 animate-fade-in">Academic Departments</h1>
                    <p class="lead opacity-75 mx-auto" style="max-width: 700px;">Explore our world-class departments,
                        visionary leadership, and cutting-edge curricula.</p>
                </div>
                <div class="position-absolute bottom-0 end-0 opacity-05 mb-n5 me-n5 rotate-15 d-none d-lg-block"
                    style="z-index: 0;">
                    <i class="fas fa-graduation-cap fa-20x"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h3 class="fw-bold text-dark mb-0">Our Faculties</h3>
            <p class="text-muted small mb-0">Discover specialization and academic excellence.</p>
        </div>
        <% if (user && user.role==='Admin' ) { %>
            <button class="btn btn-premium btn-primary shadow-sm" data-bs-toggle="modal"
                data-bs-target="#addDepartmentModal">
                <i class="fas fa-plus me-2"></i> Add Department
            </button>
            <% } %>
    </div>

    <div class="row g-4">
        <% departments.forEach(dept=> { %>
            <div class="col-md-6 col-lg-4">
                <div class="premium-card h-100 overflow-hidden d-flex flex-column">
                    <div class="card-header bg-brand border-0 p-4 position-relative overflow-hidden">
                        <div class="z-1 position-relative">
                            <h4 class="fw-bold text-white mb-1">
                                <%= dept.name %>
                            </h4>
                            <span class="badge glass-card text-white small fw-normal">HOD: <%= dept.hodName %></span>
                        </div>
                        <i class="fas fa-university position-absolute bottom-0 end-0 opacity-10 mb-n3 me-n3 text-white"
                            style="font-size: 5rem; z-index: 0;"></i>
                    </div>
                    <div class="card-body p-4 flex-grow-1">
                        <div class="mb-4">
                            <p class="text-secondary small line-clamp-3 mb-0">
                                <%= dept.mission %>
                            </p>
                        </div>

                        <div class="row g-2 mb-4">
                            <div class="col-6">
                                <div class="bg-light bg-opacity-50 p-3 rounded-4 text-center">
                                    <h6 class="fw-bold text-brand mb-0">
                                        <%= dept.totalFaculty %>
                                    </h6>
                                    <small class="text-muted" style="font-size: 0.65rem;">FACULTY</small>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="bg-light bg-opacity-50 p-3 rounded-4 text-center">
                                    <h6 class="fw-bold text-brand mb-0">
                                        <%= dept.totalStudents %>
                                    </h6>
                                    <small class="text-muted" style="font-size: 0.65rem;">STUDENTS</small>
                                </div>
                            </div>
                        </div>

                        <div class="mt-auto">
                            <a href="/departments/<%= dept._id %>"
                                class="btn btn-outline-dark w-100 rounded-pill fw-bold py-2 border-2">
                                Explore Curriculum <i class="fas fa-arrow-right ms-2 small"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <% }) %>
    </div>

    <!-- Add Department Modal (Premiumized) -->
    <div class="modal fade" id="addDepartmentModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content overflow-hidden border-0 rounded-4 shadow-lg">
                <div class="modal-header bg-brand text-white p-4 border-0">
                    <h5 class="modal-title fw-bold">New Department Entry</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form action="/departments" method="POST">
                    <div class="modal-body p-4 bg-light bg-opacity-50">
                        <div class="mb-4">
                            <label class="form-label small fw-800 text-muted text-uppercase">Department Name</label>
                            <input type="text" class="form-control border-0 shadow-sm py-2 px-3" name="name"
                                placeholder="e.g. Mechanical Engineering" required>
                        </div>
                        <div class="mb-4">
                            <label class="form-label small fw-800 text-muted text-uppercase">HOD Full Name</label>
                            <input type="text" class="form-control border-0 shadow-sm py-2 px-3" name="hodName"
                                required>
                        </div>
                        <div class="mb-4">
                            <label class="form-label small fw-800 text-muted text-uppercase">Vision Statement</label>
                            <textarea class="form-control border-0 shadow-sm py-2 px-3" name="vision" rows="3"
                                required></textarea>
                        </div>
                        <div class="mb-0">
                            <label class="form-label small fw-800 text-muted text-uppercase">Mission Statement</label>
                            <textarea class="form-control border-0 shadow-sm py-2 px-3" name="mission" rows="3"
                                required></textarea>
                        </div>
                    </div>
                    <div class="modal-footer p-4 border-0 bg-white">
                        <button type="button" class="btn btn-light px-4 rounded-pill fw-bold"
                            data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary px-4 rounded-pill fw-bold shadow-sm">Initialize
                            Department</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <style>
        .fw-800 {
            font-weight: 800;
        }

        .fa-20x {
            font-size: 20rem;
        }

        .line-clamp-3 {
            display: -webkit-box;
            -webkit-line-clamp: 3;
            line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
    </style>

    <%- include('../partials/footer') %>