<%- include('partials/header') %>

    <!-- Clubs Hero Section -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="premium-card hero-gradient overflow-hidden position-relative p-lg-5 p-4 text-white">
                <div class="row align-items-center z-1 position-relative">
                    <div class="col-lg-8">
                        <span class="badge glass-card text-white px-3 py-2 mb-3">
                            <i class="fas fa-users-rays me-2 small text-warning"></i>Student Ecosystem
                        </span>
                        <h1 class="display-3 fw-800 mb-2">Student Clubs & Organizations</h1>
                        <p class="lead opacity-75 mb-4">Discover your passion, find your tribe, and unleash your
                            potential through our diverse range of student-led communities.</p>

                        <div class="d-flex flex-wrap gap-2">
                            <% if (user && (['President', 'Vice President' , 'Member' , 'Faculty Coordinator'
                                ].includes(user.clubRole) || user.role==='Admin' )) { %>
                                <a href="/events/create" class="btn btn-premium btn-light shadow-sm">
                                    <i class="fas fa-plus me-2"></i>Propose Event
                                </a>
                                <% } %>
                                    <% if (user && (['Faculty', 'HOD' , 'Dean' , 'Director' , 'Admin'
                                        ].includes(user.role))) { %>
                                        <a href="/events/approvals" class="btn btn-premium btn-outline-light">
                                            <i class="fas fa-clipboard-check me-2"></i>Review Approvals
                                        </a>
                                        <% } %>
                        </div>
                    </div>
                </div>
                <!-- Abstract Design -->
                <div class="position-absolute bottom-0 end-0 opacity-05 mb-n5 me-n5 rotate-15 d-none d-lg-block"
                    style="z-index: 0;">
                    <i class="fas fa-users" style="font-size: 20rem;"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Clubs Grid -->
    <div class="row g-4 mb-5">
        <% clubs.forEach(club=> { %>
            <div class="col-md-6 col-lg-4">
                <div class="premium-card h-100 overflow-hidden d-flex flex-column transition-hover">
                    <div class="card-header bg-brand border-0 p-4 position-relative overflow-hidden">
                        <div class="z-1 position-relative d-flex align-items-center">
                            <div
                                class="bg-white bg-opacity-20 rounded-circle p-3 me-3 border border-white border-opacity-10">
                                <i class="fas fa-<%= club.icon %> text-white fa-lg"></i>
                            </div>
                            <h4 class="fw-bold text-white mb-0">
                                <%= club.name %>
                            </h4>
                        </div>
                        <i class="fas fa-<%= club.icon %> position-absolute bottom-0 end-0 opacity-10 mb-n3 me-n3 text-white"
                            style="font-size: 5rem; z-index: 0;"></i>
                    </div>

                    <div class="card-body p-4 flex-grow-1">
                        <p class="text-secondary small line-clamp-3 mb-4">
                            <%= club.description %>
                        </p>

                        <div class="bg-light bg-opacity-50 rounded-4 p-3 mb-4">
                            <div class="d-flex align-items-center mb-2">
                                <i class="fas fa-user-tie text-brand opacity-50 me-2 small"></i>
                                <span class="small fw-bold text-dark">Liaison: <%= club.coordinator %></span>
                            </div>
                            <div class="d-flex align-items-center">
                                <i class="fas fa-user-group text-brand opacity-50 me-2 small"></i>
                                <span class="small text-muted">
                                    <%= club.members %> Active Members
                                </span>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <a href="/clubs/<%= club.slug %>" class="btn btn-brand rounded-pill py-2 fw-bold shadow-sm">
                                <i class="fas fa-sparkles me-2 small"></i>View Pulse Highlights
                            </a>
                            <button class="btn btn-outline-brand rounded-pill py-2 fw-bold small">
                                Join Tribe
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <% }) %>
    </div>

    <style>
        .hero-gradient {
            background: linear-gradient(135deg, #021849 0%, #052c7a 100%);
        }

        .fw-800 {
            font-weight: 800;
        }

        .bg-brand {
            background-color: #021849 !important;
        }

        .text-brand {
            color: #021849 !important;
        }

        .btn-brand {
            background: #021849;
            color: white;
            border: none;
        }

        .btn-brand:hover {
            background: #052c7a;
            color: white;
        }

        .btn-outline-brand {
            border: 2px solid #021849;
            color: #021849;
            font-weight: bold;
            transition: all 0.3s ease;
        }

        .btn-outline-brand:hover {
            background: #021849;
            color: white;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 15px;
        }

        .transition-hover {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .transition-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(2, 24, 73, 0.1) !important;
        }

        .line-clamp-3 {
            display: -webkit-box;
            -webkit-line-clamp: 3;
            line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .rotate-15 {
            transform: rotate(15deg);
        }
    </style>

    <%- include('partials/footer') %>