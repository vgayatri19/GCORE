<%- include('partials/header', { title }) %><%- include('partials/navbar') %>
<div class="container py-4"><h2>Admin Controls</h2>
<div class="row g-3"><div class="col-lg-6"><div class="card p-3"><h4>User Management</h4><div class="table-responsive"><table class="table"><thead><tr><th>Name</th><th>Role</th><th>Assign</th></tr></thead><tbody><% users.forEach(u => { %><tr><td><%= u.name %></td><td><%= u.role %></td><td><form method="POST" action="/admin/users/<%= u._id %>/role" class="d-flex"><select name="role" class="form-select form-select-sm me-1"><option>student</option><option>faculty</option><option>club_coordinator</option><option>placement_user</option><option>admin</option></select><button class="btn btn-sm btn-primary">Save</button></form></td></tr><% }) %></tbody></table></div></div></div>
<div class="col-lg-6"><div class="card p-3"><h4>Event Approvals</h4><% pendingEvents.forEach(e => { %><div class="d-flex justify-content-between border-bottom py-2"><span><%= e.title %> by <%= e.createdBy?.name || '' %></span><form method="POST" action="/admin/events/<%= e._id %>/approve" class="d-flex"><select class="form-select form-select-sm me-1" name="status"><option value="approved">Approve</option><option value="rejected">Reject</option></select><button class="btn btn-sm btn-primary">Submit</button></form></div><% }) %></div></div></div>
<div class="card p-3 mt-3"><h4>Audit Logs</h4><div class="table-responsive"><table class="table"><thead><tr><th>Time</th><th>Admin</th><th>Action</th><th>Metadata</th></tr></thead><tbody><% logs.forEach(l => { %><tr><td><%= new Date(l.createdAt).toLocaleString() %></td><td><%= l.admin?.name || 'N/A' %></td><td><%= l.action %></td><td><code><%= JSON.stringify(l.metadata) %></code></td></tr><% }) %></tbody></table></div></div>
</div><%- include('partials/footer') %>
