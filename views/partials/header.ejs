<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GCORE - Institutional Management System</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-brand sticky-top py-3 shadow-sm">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="/">
                <div class="bg-white rounded-circle p-2 me-2 d-inline-flex align-items-center justify-content-center"
                    style="width: 35px; height: 35px;">
                    <i class="fas fa-cube text-brand small"></i>
                </div>
                GCORE
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto gap-2">
                    <li class="nav-item"><a class="nav-link rounded-pill px-3" href="/">Home</a></li>
                    <li class="nav-item"><a class="nav-link rounded-pill px-3" href="/departments">Departments</a></li>
                    <li class="nav-item"><a class="nav-link rounded-pill px-3" href="/placements">Placements</a></li>
                    <li class="nav-item"><a class="nav-link rounded-pill px-3" href="/clubs">Clubs</a></li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle rounded-pill px-3" href="#" role="button"
                            data-bs-toggle="dropdown">Resources</a>
                        <ul class="dropdown-menu border-0 shadow-lg p-3 rounded-4">
                            <li><a class="dropdown-item rounded-3" href="/about">About Us</a></li>
                            <li><a class="dropdown-item rounded-3" href="/contact">Contact</a></li>
                        </ul>
                    </li>
                    <% if (locals.user) { %>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle btn btn-white bg-white text-brand rounded-pill px-4 ms-lg-2 fw-bold shadow-sm"
                                href="#" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-user-circle me-1"></i>
                                <%= user.name.split(' ')[0] %>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg p-3 rounded-4">
                                <li class="px-3 py-2 border-bottom mb-2">
                                    <small class="text-muted d-block">Logged in as</small>
                                    <span class="fw-bold"><%= user.role %></span>
                                </li>
                                <% if (user.role === 'Admin') { %>
                        <li><a class="dropdown-item rounded-3" href="/admin/dashboard">
                                <i class="fas fa-user-shield me-2"></i>Admin Panel</a>
                        </li>
                        <% } %>
                            <li><a class="dropdown-item rounded-3" href="#" data-bs-toggle="modal" data-bs-target="#changePasswordModal">
                                    <i class="fas fa-key me-2"></i>Change Password</a>
                            </li>
                            <li><a class="dropdown-item rounded-3 text-danger" href="/auth/logout">
                                    <i class="fas fa-sign-out-alt me-2"></i>Logout</a>
                            </li>
                </ul>
                </li>
                <% } else { %>
                    <li class="nav-item"><a class="nav-link px-3" href="/auth/login">Login</a></li>
                    <li class="nav-item"><a
                            class="nav-link btn btn-primary text-white px-4 rounded-pill ms-lg-2 shadow-sm"
                            href="/auth/register">Join Now</a></li>
                    <% } %>
                        </ul>
            </div>
        </div>
    </nav>
    <div class="container my-5">

    <!-- Global Change Password Modal -->
    <div class="modal fade" id="changePasswordModal" tabindex="-1" aria-labelledby="changePasswordModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
          <div class="modal-header bg-brand text-white border-0 py-3">
            <h5 class="modal-title fw-bold" id="changePasswordModalLabel"><i class="fas fa-lock me-2 text-warning"></i>Change Password</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <form action="/auth/change-password" method="POST">
              <div class="modal-body p-4 bg-light">
                <div class="mb-3">
                    <label class="form-label small fw-bold text-muted text-uppercase">Current Password</label>
                    <input type="password" class="form-control border-light shadow-sm" name="currentPassword" required>
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-bold text-muted text-uppercase">New Password</label>
                    <input type="password" class="form-control border-light shadow-sm" name="newPassword" 
                           pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z0-9\s]).{8,}$" 
                           title="Minimum 8 chars, 1 uppercase, 1 lowercase, 1 number, 1 special char" required>
                </div>
                <div class="mb-1">
                    <label class="form-label small fw-bold text-muted text-uppercase">Confirm New Password</label>
                    <input type="password" class="form-control border-light shadow-sm" name="confirmPassword" required>
                </div>
              </div>
              <div class="modal-footer border-0 p-3 bg-white">
                <button type="button" class="btn btn-light rounded-pill px-4 fw-bold shadow-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-warning rounded-pill px-4 fw-bold shadow-sm">Update Password</button>
              </div>
          </form>
        </div>
      </div>
    </div>