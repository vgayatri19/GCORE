<%- include('../partials/header') %>

<!-- Inject Chart.js for Hero Graph -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="container-fluid py-4 min-vh-100 bg-light">
    <!-- 6. Personalization & Alerts: Urgent Banner -->
    <% if (urgentAlerts > 0) { %>
        <div class="alert alert-danger border-0 shadow-sm rounded-4 mb-4 d-flex align-items-center animate-fade-in">
            <i class="fas fa-exclamation-triangle fa-lg me-3 animate-pulse"></i>
            <div>
                <strong>Urgent Action Required:</strong> There are <strong><%= urgentAlerts %></strong> placement drives closing within the next 3 days!
                <a href="#drivesList" class="alert-link ms-2">View closing drives <i class="fas fa-arrow-right small"></i></a>
            </div>
        </div>
    <% } %>

    <!-- 1. Hero Section -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="premium-card hero-gradient overflow-hidden position-relative p-lg-5 p-4 text-white shadow-lg rounded-4">
                <div class="row align-items-center position-relative" style="z-index: 2;">
                    <!-- Left: Titles and Buttons -->
                    <div class="col-lg-7 mb-4 mb-lg-0">
                        <span class="badge glass-card text-white px-3 py-2 mb-3 shadow-sm border border-white border-opacity-25">
                            <i class="fas fa-rocket me-2 text-warning"></i>Placement Intelligence
                        </span>
                        <h1 class="display-4 fw-black mb-3 text-white" style="letter-spacing: -1px;">Placement Intelligence Dashboard</h1>
                        <p class="lead opacity-90 mb-4 fw-normal" style="max-width: 600px;">
                            Track opportunities, analyze trends, and improve placement readiness. Your professional success starts here.
                        </p>
                        <div class="d-flex flex-wrap gap-3">
                            <a href="#drivesList" class="btn btn-warning btn-premium px-4 py-2 fw-bold text-dark shadow transition-hover rounded-pill">
                                <i class="fas fa-briefcase me-2"></i>View All Drives
                            </a>
                            <a href="/guidance/ats-checker" class="btn btn-premium btn-outline-light px-4 py-2 fw-bold shadow-sm transition-hover rounded-pill bg-white bg-opacity-10 border-2">
                                <i class="fas fa-file-invoice me-2"></i>Analyze Resume (ATS)
                            </a>
                            <% if (user && (user.role==='Admin' || user.role==='Placement Officer' )) { %>
                                <button class="btn btn-premium btn-light px-3 py-2 fw-bold text-dark shadow transition-hover rounded-pill" data-bs-toggle="modal" data-bs-target="#addDriveModal">
                                    <i class="fas fa-plus me-1"></i>Schedule Drive
                                </button>
                            <% } %>
                        </div>
                    </div>
                    
                    <!-- Right: Mini Graph (Placement Trend) -->
                    <div class="col-lg-5">
                        <div class="glass-card p-4 rounded-4 shadow border border-white border-opacity-25 animate-fade-in" style="background: rgba(0,0,0,0.15); backdrop-filter: blur(12px);">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="fw-bold mb-0 text-white"><i class="fas fa-chart-line me-2 text-info"></i>Placement Trend</h6>
                                <span class="badge bg-white bg-opacity-25 text-white">Batches 2022-2025</span>
                            </div>
                            <div style="height: 140px;">
                                <canvas id="heroTrendChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Background visual -->
                <div class="position-absolute top-0 end-0 opacity-10 mt-n4 me-n4 d-none d-lg-block" style="z-index: 1;">
                    <i class="fas fa-globe" style="font-size: 25rem;"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. Interactive Stats Matrix -->
    <div class="row g-4 mb-5">
        <div class="col-6 col-md-3">
            <div class="premium-card p-4 h-100 bg-brand text-white shadow rounded-4 transition-hover cursor-pointer" 
                 data-bs-toggle="tooltip" data-bs-placement="top" title="Cumulative unique global recruiters since 2021">
                <div class="bg-white bg-opacity-10 rounded-circle d-inline-flex p-3 mb-3 border border-white border-opacity-10">
                    <i class="fas fa-building text-warning fa-lg"></i>
                </div>
                <h6 class="text-uppercase small fw-bold opacity-75 mb-2">Companies <i class="fas fa-info-circle ms-1 small"></i></h6>
                <h2 class="fw-800 mb-1"><%= stats.companies %>+</h2>
                <small class="opacity-75" style="font-size: 0.7rem;">(Last 3 Years)</small>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="premium-card p-4 h-100 shadow-sm border border-light rounded-4 bg-white transition-hover cursor-pointer"
                 data-bs-toggle="tooltip" data-bs-placement="top" title="Verified placement offers distributed to passing batch">
                <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex p-3 mb-3 text-success">
                    <i class="fas fa-hand-holding-heart fa-lg"></i>
                </div>
                <h6 class="text-uppercase small fw-bold text-muted mb-2">Offers <i class="fas fa-info-circle ms-1 small"></i></h6>
                <h2 class="fw-800 mb-1 text-dark"><%= stats.offers %>+</h2>
                <small class="text-secondary" style="font-size: 0.7rem;">(2025 Batch)</small>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="premium-card p-4 h-100 shadow-sm border border-light rounded-4 bg-white transition-hover cursor-pointer"
                 data-bs-toggle="tooltip" data-bs-placement="top" title="Highest CTC achieved by Amazon SDE roles">
                <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex p-3 mb-3 text-primary">
                    <i class="fas fa-gem fa-lg"></i>
                </div>
                <h6 class="text-uppercase small fw-bold text-muted mb-2">Highest <i class="fas fa-info-circle ms-1 small"></i></h6>
                <h2 class="fw-800 mb-1 text-dark"><%= stats.highestPackage %></h2>
                <small class="text-secondary" style="font-size: 0.7rem;">(Amazon - SDE)</small>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="premium-card p-4 h-100 shadow-sm border border-light rounded-4 bg-white transition-hover cursor-pointer"
                 data-bs-toggle="tooltip" data-bs-placement="top" title="Average CTC across core computing branches">
                <div class="bg-warning bg-opacity-10 rounded-circle d-inline-flex p-3 mb-3 text-warning">
                    <i class="fas fa-chart-pie fa-lg"></i>
                </div>
                <h6 class="text-uppercase small fw-bold text-muted mb-2">Avg Pkg <i class="fas fa-info-circle ms-1 small"></i></h6>
                <h2 class="fw-800 mb-1 text-dark"><%= stats.avgPackage %></h2>
                <small class="text-secondary" style="font-size: 0.7rem;">(CSE / AIML AVG)</small>
            </div>
        </div>
    </div>

    <!-- Center Stage & Two Column Layout -->
    <div class="row g-4 mb-5">
        
        <!-- Left Column: Centerstage Main Features -->
        <div class="col-lg-8 d-flex flex-column gap-4">
            
            <!-- 4. Career Accelerator (Centerstage) & Resume Score Widget -->
            <div class="row g-4">
                <div class="col-12">
                    <h5 class="fw-bold text-dark d-flex align-items-center mb-0">
                        <i class="fas fa-rocket text-primary me-2"></i> Career Tools & Prominences
                    </h5>
                </div>
                
                <% if (user && user.role === 'Student') { %>
                <!-- Personalized ATS Widget -->
                <div class="col-md-6">
                    <div class="premium-card p-4 h-100 bg-white shadow-sm border border-light rounded-4 d-flex flex-column transition-hover">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="bg-brand bg-opacity-10 text-brand p-2 rounded-3"><i class="fas fa-robot fa-lg"></i></div>
                            <span class="badge <%= atsScore > 75 ? 'bg-success' : 'bg-warning text-dark' %> rounded-pill">Active Scan</span>
                        </div>
                        <h5 class="fw-bold mb-1">Your ATS Score</h5>
                        <p class="text-muted small mb-4">Latest CV analysis against technical metrics.</p>
                        
                        <div class="mt-auto">
                            <div class="d-flex justify-content-between align-items-end mb-1">
                                <span class="display-6 fw-800 <%= atsScore > 75 ? 'text-success' : 'text-warning' %>"><%= atsScore %>%</span>
                                <span class="small fw-bold text-muted mb-2 text-uppercase">Needs Improvement</span>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar <%= atsScore > 75 ? 'bg-success' : 'bg-warning' %>" role="progressbar" style="width: <%= atsScore %>%"></div>
                            </div>
                            <a href="/guidance/ats-checker" class="btn btn-brand w-100 mt-4 rounded-pill fw-bold shadow-sm">Improve Resume Score</a>
                        </div>
                    </div>
                </div>
                <% } else { %>
                <!-- Generic Huge ATS CTA for non-students -->
                <div class="col-md-6">
                    <div class="premium-card p-4 h-100 bg-white shadow-sm border border-light rounded-4 d-flex flex-column align-items-center justify-content-center text-center transition-hover">
                        <div class="bg-brand text-white p-4 rounded-circle mb-3 shadow"><i class="fas fa-file-invoice fa-2x"></i></div>
                        <h4 class="fw-bold">ATS Resume Analyzer</h4>
                        <p class="text-muted small px-3">Scan your exact resume against Job Descriptions using our NLP engine entirely for free.</p>
                        <a href="/guidance/ats-checker" class="btn btn-brand rounded-pill px-4 py-2 mt-2 shadow">Launch Analyzer</a>
                    </div>
                </div>
                <% } %>
                
                <!-- Quick Accelerators -->
                <div class="col-md-6">
                    <div class="premium-card p-0 h-100 bg-transparent border-0 d-flex flex-column gap-3">
                        <a href="/guidance/interview-prep" class="card card-body flex-row align-items-center text-decoration-none text-dark bg-white shadow-sm rounded-4 border-light transition-hover h-50">
                            <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle me-3"><i class="fas fa-chalkboard-user fa-lg"></i></div>
                            <div>
                                <h6 class="fw-bold mb-1">Interview Simulator</h6>
                                <p class="text-muted small mb-0">Mock corporate rounds & technical prep</p>
                            </div>
                            <i class="fas fa-chevron-right ms-auto text-muted small opacity-50"></i>
                        </a>
                        <a href="/guidance/skill-dev" class="card card-body flex-row align-items-center text-decoration-none text-dark bg-white shadow-sm rounded-4 border-light transition-hover h-50">
                            <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-circle me-3"><i class="fas fa-laptop-code fa-lg"></i></div>
                            <div>
                                <h6 class="fw-bold mb-1">Skill Gap Analyzer & Forge</h6>
                                <p class="text-muted small mb-0">Certifications & targeted soft skills</p>
                            </div>
                            <i class="fas fa-chevron-right ms-auto text-muted small opacity-50"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Personalized Recommendation Section -->
            <% if (user && user.role === 'Student' && recommendedDrives.length > 0) { %>
            <div class="premium-card p-4 bg-white shadow-sm rounded-4 border-start border-5 border-success mt-2">
                <h5 class="fw-bold text-dark d-flex align-items-center mb-4">
                    <i class="fas fa-magic text-warning me-2"></i> Recommended for YOU
                </h5>
                <div class="row g-3">
                    <% recommendedDrives.forEach(drive => { %>
                        <div class="col-md-4">
                            <div class="card border border-light shadow-sm rounded-3 h-100 hover-up">
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between mb-2">
                                        <h6 class="fw-bold text-brand mb-0 line-clamp-1"><%= drive.companyName %></h6>
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill align-self-start border"><%= drive.package %> L</span>
                                    </div>
                                    <p class="text-muted small mb-3 line-clamp-1"><%= drive.role %></p>
                                    <form action="/placements/<%= drive._id %>/apply" method="POST">
                                        <button type="submit" class="btn btn-sm btn-outline-success w-100 rounded-pill shadow-sm">Quick Apply</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
            <% } %>

        </div>

        <!-- Right Column: Analytics & Pulse -->
        <div class="col-lg-4">
            <!-- 3. Placement Pulse (Progress Bars) -->
            <div class="premium-card p-4 h-100 bg-white shadow-sm border border-light rounded-4">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                    <h5 class="fw-bold text-dark mb-0">Placement Pulse</h5>
                    <span class="badge bg-light text-muted border">Live Data</span>
                </div>
                
                <% placementPulse.forEach(deptData => { %>
                    <div class="mb-3 cursor-pointer" data-bs-toggle="modal" data-bs-target="#modal-<%= deptData.dept.replace(/[^a-zA-Z0-9]/g, '') %>">
                        <div class="d-flex justify-content-between align-items-end mb-1">
                            <span class="fw-bold small text-dark"><%= deptData.dept %>
                                <% if (topDepartment === deptData.dept) { %>
                                    <span class="badge bg-danger bg-opacity-10 text-danger ms-1 border-0" data-bs-toggle="tooltip" title="Top performing department">🔥 Leader</span>
                                <% } %>
                            </span>
                            <span class="small fw-800 <%= topDepartment === deptData.dept ? 'text-brand' : 'text-muted' %>"><%= deptData.percentage %>%</span>
                        </div>
                        <div class="progress" style="height: 6px; background-color: #f1f5f9;">
                            <div class="progress-bar <%= topDepartment === deptData.dept ? 'bg-brand progress-bar-striped progress-bar-animated' : 'bg-primary opacity-50' %>" 
                                 role="progressbar" style="width: <%= deptData.percentage %>%"></div>
                        </div>
                        <div class="text-end mt-1"><small class="text-muted" style="font-size: 0.65rem;"><%= deptData.placedCount %> Placed Users</small></div>
                    </div>
                <% }) %>

                <div class="mt-4 text-center bg-light rounded-3 p-3">
                    <small class="opacity-75 text-muted"><i class="fas fa-hand-pointer me-1"></i> Click any department bar to view placed student details</small>
                </div>
            </div>
        </div>
    </div>

    <!-- 5. Live Recruitment Drives Section (Modern Card Grid) -->
    <div class="row mb-4 align-items-end" id="drivesList">
        <div class="col-md-6">
            <h4 class="fw-bold text-dark mb-1 d-flex align-items-center">
                Live Recruitment Drives 
                <div class="ms-3 badge bg-danger bg-opacity-10 text-danger px-2 py-1 align-items-center d-flex border border-danger border-opacity-25 rounded-pill shadow-sm" style="font-size: 0.7rem;">
                    <span class="spinner-grow spinner-grow-sm text-danger me-2" style="width: 8px; height: 8px;"></span> Live
                </div>
            </h4>
            <p class="text-muted small mb-0">Find and apply to active campus and off-campus corporate opportunities.</p>
        </div>
        <div class="col-md-6 mt-3 mt-md-0">
            <!-- Filter Row -->
            <div class="d-flex justify-content-md-end gap-2">
                <input type="text" id="driveSearchField" class="form-control form-control-sm border-light shadow-sm w-auto rounded-pill px-3" placeholder="Search by role or company..." onkeyup="filterDrives()">
                <select id="drivePackageFilter" class="form-select form-select-sm border-light shadow-sm w-auto rounded-pill ps-3 pe-4" onchange="filterDrives()">
                    <option value="all">Every Package</option>
                    <option value="high">> 10 LPA</option>
                    <option value="med">> 5 LPA</option>
                </select>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-5" id="drivesGrid">
        <% if (drives.length === 0) { %>
            <div class="col-12 text-center py-5 bg-white shadow-sm rounded-4 border border-light">
                <i class="fas fa-folder-open text-muted opacity-25 fa-4x mb-3"></i>
                <h5 class="text-muted">No Live Drives Currently</h5>
                <p class="text-secondary small">Please check back later or contact the placement cell.</p>
            </div>
        <% } %>

        <% drives.forEach((drive, idx) => { 
            const daysLeft = Math.ceil((new Date(drive.applicationDeadline) - today) / (1000 * 60 * 60 * 24));
            let urgencyType = "normal";
            if (daysLeft < 0) urgencyType = "expired";
            else if (daysLeft <= 3) urgencyType = "urgent";
            else urgencyType = "open";
            
            let applyStatus = "none";
            if (user && user.role === 'Student') {
                if (myAppDriveIds.includes(drive._id.toString())) applyStatus = "applied";
            }
        %>
            <div class="col-xl-4 col-lg-6 drive-card-wrapper" data-company="<%= drive.companyName.toLowerCase() %>" data-role="<%= drive.role.toLowerCase() %>" data-pkg="<%= parseInt(drive.package)||0 %>">
                <div class="premium-card h-100 bg-white shadow-sm border border-light rounded-4 overflow-hidden position-relative transition-hover d-flex flex-column">
                    
                    <!-- Card Header / Status Badge -->
                    <div class="p-4 border-bottom bg-light bg-opacity-50">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="fw-bold text-brand mb-0 line-clamp-1 w-75"><%= drive.companyName %></h5>
                            
                            <% if (applyStatus === 'applied') { %>
                                <span class="badge bg-success shadow-sm rounded-pill"><i class="fas fa-check-circle me-1"></i>Applied</span>
                            <% } else if (urgencyType === 'urgent') { %>
                                <span class="badge bg-danger shadow-sm rounded-pill animate-pulse"><i class="fas fa-clock me-1"></i><%= daysLeft %> Days Left 🔴</span>
                            <% } else if (urgencyType === 'open') { %>
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill shadow-sm">Open 🟢</span>
                            <% } %>
                        </div>
                        <div class="fw-bold text-dark small"><%= drive.role %></div>
                    </div>
                    
                    <!-- Card Body -->
                    <div class="p-4 flex-grow-1">
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <span class="badge bg-light text-dark border px-2 py-1 fw-normal shadow-sm" style="font-size: 0.75rem;">
                                <i class="fas fa-money-bill-wave text-success me-1"></i> <%= drive.package %> LPA
                            </span>
                            <span class="badge bg-light text-dark border px-2 py-1 fw-normal shadow-sm" style="font-size: 0.75rem;">
                                <i class="fas fa-calendar text-primary me-1"></i> Deadline: <%= new Date(drive.applicationDeadline).toLocaleDateString() %>
                            </span>
                        </div>
                        <div class="small text-muted mb-1 fw-bold text-uppercase" style="font-size: 0.65rem;">Eligibility</div>
                        <p class="small text-secondary line-clamp-2 mb-0" style="line-height: 1.4;"><%= drive.eligibilityCriteria %></p>
                    </div>
                    
                    <!-- Card Footer Actions -->
                    <div class="p-3 bg-white border-top d-flex gap-2">
                        <% if (user && user.role === 'Student') { %>
                            <% if (applyStatus === 'applied') { %>
                                <button class="btn btn-secondary w-100 rounded-pill py-2 shadow-sm" disabled>Successfully Applied</button>
                            <% } else { %>
                                <form action="/placements/<%= drive._id %>/apply" method="POST" class="w-50">
                                    <button type="submit" class="btn btn-brand w-100 rounded-pill py-2 shadow-sm fw-bold">Apply Now</button>
                                </form>
                                <button class="btn btn-outline-brand w-50 rounded-pill py-2 shadow-sm bg-light fw-bold" disabled>View Details</button>
                            <% } %>
                        <% } else if (user && (user.role === 'Admin' || user.role === 'Placement Officer')) { %>
                            <a href="/placements/<%= drive._id %>" class="btn btn-outline-brand w-100 rounded-pill py-2 shadow-sm bg-light fw-bold">Manage Drive <i class="fas fa-cogs ms-1"></i></a>
                        <% } else { %>
                            <a href="/login" class="btn btn-brand w-100 rounded-pill py-2 shadow-sm fw-bold"><i class="fas fa-lock me-1"></i> Login to Apply</a>
                        <% } %>
                    </div>

                </div>
            </div>
        <% }) %>
    </div>
</div>

<!-- Modals for Department Detailed Placement Data -->
<% Object.keys(distribution).forEach(dept => { %>
<div class="modal fade" id="modal-<%= dept.replace(/[^a-zA-Z0-9]/g, '') %>" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 overflow-hidden shadow-lg">
            <div class="modal-header bg-brand text-white p-4 d-flex justify-content-between border-0">
                <h5 class="modal-title fw-bold d-flex align-items-center"><i class="fas fa-users me-2 text-warning"></i> <%= dept %> Placements</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0 bg-light">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 bg-white">
                        <thead class="bg-light">
                            <tr class="text-muted small fw-800 text-uppercase border-bottom">
                                <th class="ps-4 py-3">Candidate</th>
                                <th class="py-3">Roll Number</th>
                                <th class="py-3">Organization</th>
                                <th class="pe-4 py-3 text-end">Package</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% distribution[dept].forEach(record => { %>
                                <tr class="border-light">
                                    <td class="ps-4 py-3">
                                        <div class="fw-bold text-dark"><%= record.studentName %></div>
                                        <small class="text-muted"><i class="fas fa-graduation-cap me-1"></i><%= record.type %></small>
                                    </td>
                                    <td class="py-3"><code class="bg-light px-2 py-1 rounded-3 text-dark border shadow-sm"><%= record.rollNumber %></code></td>
                                    <td class="py-3">
                                        <div class="fw-bold text-brand"><i class="fas fa-building me-1 opacity-50"></i><%= record.company %></div>
                                    </td>
                                    <td class="pe-4 py-3 text-end">
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 border border-success border-opacity-25 shadow-sm">
                                            <%= record.package %> LPA
                                        </span>
                                    </td>
                                </tr>
                            <% }) %>
                            <% if(distribution[dept].length === 0) { %>
                                <tr><td colspan="4" class="text-center py-4 text-muted">No placement records logged yet.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<% }) %>

<!-- Add Drive Modal -->
<% if (user && (user.role === 'Admin' || user.role === 'Placement Officer')) { %>
<div class="modal fade" id="addDriveModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 overflow-hidden shadow-lg">
            <div class="modal-header bg-brand text-white p-4 border-0">
                <h5 class="modal-title fw-bold"><i class="fas fa-calendar-plus me-2 text-warning"></i>Schedule New Drive</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="/placements" method="POST">
                <div class="modal-body p-4 bg-light">
                    <div class="mb-3">
                        <label class="form-label small fw-800 text-muted text-uppercase">Company Name</label>
                        <input type="text" class="form-control border-light shadow-sm py-2 px-3 rounded-3" name="companyName" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-800 text-muted text-uppercase">Role</label>
                        <input type="text" class="form-control border-light shadow-sm py-2 px-3 rounded-3" name="role" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-800 text-muted text-uppercase">Eligibility Details</label>
                        <textarea class="form-control border-light shadow-sm py-2 px-3 rounded-3" name="eligibilityCriteria" rows="2" placeholder="e.g. BTech CSE/AIML, 60%+" required></textarea>
                    </div>
                    <div class="row">
                        <div class="col">
                            <div class="mb-3">
                                <label class="form-label small fw-800 text-muted text-uppercase">Pkg (LPA)</label>
                                <input type="number" step="0.1" class="form-control border-light shadow-sm px-3 py-2 rounded-3" name="package" required>
                            </div>
                        </div>
                        <div class="col">
                            <div class="mb-3">
                                <label class="form-label small fw-800 text-muted text-uppercase">Deadline</label>
                                <input type="date" class="form-control border-light shadow-sm px-3 py-2 rounded-3" name="applicationDeadline" required>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer p-4 border-0 bg-white">
                    <button type="submit" class="btn btn-brand w-100 rounded-pill py-3 fw-bold shadow transition-hover">Broadcast Recruitment Drive</button>
                </div>
            </form>
        </div>
    </div>
</div>
<% } %>

<style>
    /* Premium Spacing & Consistency Additions */
    .premium-card { border-radius: 1.5rem; }
    .hero-gradient { background: linear-gradient(135deg, #021849 0%, #052c7a 100%); }
    .fw-black { font-weight: 900; }
    .fw-800 { font-weight: 800; }
    .bg-brand { background-color: #021849 !important; }
    .text-brand { color: #021849 !important; }
    .btn-brand { background: #021849; color: white; border: none; }
    .btn-brand:hover { background: #052c7a; color: white; }
    .btn-outline-brand { border: 2px solid #021849; color: #021849; font-weight: bold; transition: all 0.3s ease;}
    .btn-outline-brand:hover { background: #021849; color: white; }
    .btn-premium { border-radius: 50rem; letter-spacing: 0.3px; }
    
    .glass-card { background: rgba(255, 255, 255, 0.1); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.2); }
    .transition-hover { transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
    .transition-hover:hover { transform: translateY(-4px); box-shadow: 0 1rem 3rem rgba(0,0,0,.1) !important; z-index: 10; }
    .hover-up { transition: transform 0.2s; }
    .hover-up:hover { transform: translateY(-3px); }
    .cursor-pointer { cursor: pointer; }

    .line-clamp-1 { display: -webkit-box; -webkit-line-clamp: 1; line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
    .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    
    .animate-pulse { animation: pulse 2s infinite; }
    @keyframes pulse { 0% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.1); opacity: 0.8; } 100% { transform: scale(1); opacity: 1; } }
    .animate-fade-in { animation: fadeIn 0.8s ease-out; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });

        // Hero Trend Chart (Static Data but interactive feel)
        const ctxElem = document.getElementById('heroTrendChart');
        if (ctxElem) {
            const ctx = ctxElem.getContext('2d');
            const gradient = ctx.createLinearGradient(0, 0, 0, 140);
            gradient.addColorStop(0, 'rgba(255, 255, 255, 0.5)');
            gradient.addColorStop(1, 'rgba(255, 255, 255, 0.0)');

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['2021', '2022', '2023', '2024', '2025(P)'],
                    datasets: [{
                        label: 'Placements',
                        data: [420, 480, 510, 545, 578],
                        borderColor: '#ffffff',
                        borderWidth: 3,
                        backgroundColor: gradient,
                        fill: true,
                        tension: 0.4,
                        pointBackgroundColor: '#ffc107',
                        pointBorderColor: '#ffffff',
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { grid: { display: false }, ticks: { color: 'rgba(255,255,255,0.7)', font: { size: 10 } } },
                        y: { display: false, min: 400 }
                    },
                    interaction: { intersect: false, mode: 'index' }
                }
            });
        }
    });

    // Frontend Search & Filtering for live drives
    function filterDrives() {
        const searchInput = document.getElementById('driveSearchField').value.toLowerCase();
        const pkgFilter = document.getElementById('drivePackageFilter').value;
        const cards = document.querySelectorAll('.drive-card-wrapper');

        cards.forEach(card => {
            const company = card.getAttribute('data-company');
            const role = card.getAttribute('data-role');
            const package = parseFloat(card.getAttribute('data-pkg'));

            let matchSearch = company.includes(searchInput) || role.includes(searchInput);
            let matchPkg = true;

            if(pkgFilter === 'high') matchPkg = package >= 10;
            else if(pkgFilter === 'med') matchPkg = package >= 5;

            if (matchSearch && matchPkg) {
                card.style.display = 'block';
            } else {
                card.style.display = 'none';
            }
        });
    }
</script>

