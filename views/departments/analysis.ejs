<%- include('../partials/header') %>

<div class="container-fluid py-4 bg-light">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="premium-card bg-brand text-white p-5 rounded-4 shadow-lg overflow-hidden position-relative">
                <div class="row align-items-center z-1 position-relative">
                    <div class="col-md-8">
                        <h1 class="display-4 fw-800 mb-2">Institutional Intelligence</h1>
                        <p class="lead opacity-75 mb-0">
                            <%= department.name %> Comprehensive Performance Audit
                        </p>
                    </div>
                    <div class="col-md-4 text-md-end d-flex flex-column align-items-md-end gap-3">
                        <div class="d-print-none d-flex gap-2">
                            <button onclick="window.print()" class="btn btn-warning rounded-pill px-4 fw-bold shadow-sm">
                                <i class="fas fa-file-pdf me-2"></i> Save Report
                            </button>
                            <% if (user && (user.role === 'Admin' || user.role === 'HOD')) { %>
                                <div class="dropdown">
                                    <button class="btn btn-light rounded-pill px-4 fw-bold shadow-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                        <i class="fas fa-upload me-2"></i> Import Data
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 mt-2">
                                        <li>
                                            <form action="/departments/<%= department._id %>/upload" method="POST" enctype="multipart/form-data" class="px-3 py-2">
                                                <small class="text-muted d-block mb-1">Achievements (Excel/CSV)</small>
                                                <input type="file" name="file" class="form-control form-control-sm mb-2" required>
                                                <button type="submit" class="btn btn-brand btn-sm w-100">Upload Achievements</button>
                                            </form>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form action="/departments/<%= department._id %>/upload-academics" method="POST" enctype="multipart/form-data" class="px-3 py-2">
                                                <small class="text-muted d-block mb-1">Academic Records (Excel/CSV)</small>
                                                <input type="file" name="file" class="form-control form-control-sm mb-2" required>
                                                <button type="submit" class="btn btn-success btn-sm w-100">Upload Academics</button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            <% } %>
                        </div>
                        <div class="glass-card px-4 py-3">
                            <h2 class="fw-bold mb-0 text-warning">
                                <%= total %>
                            </h2>
                            <small class="text-uppercase opacity-75">Total Records Analyzed</small>
                        </div>
                    </div>
                </div>
                <i class="fas fa-microscope position-absolute bottom-0 end-0 opacity-10 mb-n4 me-n4" style="font-size: 12rem;"></i>
            </div>
        </div>
    </div>

    <!-- 1. Executive Summary / Quick Metrics -->
    <div class="row mb-4 g-3 d-print-none">
        <div class="col-md-3">
            <div class="metric-card p-3 rounded-3 shadow-sm bg-white border-start border-primary border-4">
                <small class="text-muted text-uppercase fw-bold">Student Engagement</small>
                <h2 class="mb-0"><%= stats.engagement.participationRate %>%</h2>
                <div class="progress mt-2" style="height: 5px;">
                    <div class="progress-bar" style="width: <%= stats.engagement.participationRate %>%"></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="metric-card p-3 rounded-3 shadow-sm bg-white border-start border-success border-4">
                <small class="text-muted text-uppercase fw-bold">Academic Quality</small>
                <h2 class="mb-0"><%= stats.academics.passRate %>% Pass</h2>
                <small class="text-success">Avg CGPA: <%= stats.academics.avgCgpa %></small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="metric-card p-3 rounded-3 shadow-sm bg-white border-start border-warning border-4">
                <small class="text-muted text-uppercase fw-bold">Efficiency Impact</small>
                <h2 class="mb-0"><%= stats.efficiency.avgApprovalDays %> Days</h2>
                <small class="text-muted">Avg Processing Time</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="metric-card p-3 rounded-3 shadow-sm bg-white border-start border-info border-4">
                <small class="text-muted text-uppercase fw-bold">Placement Growth</small>
                <h2 class="mb-0">+<%= (total > 0 ? ((stats.skills.certs / total) * 100).toFixed(0) : 0) %>%</h2>
                <small class="text-muted">Skill Intensity Index</small>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- 2. Extracurricular Engagement Analysis -->
        <div class="col-md-6">
            <div class="premium-card p-4 h-100 shadow-sm border-0">
                <h5 class="fw-bold mb-4 d-flex align-items-center">
                    <i class="fas fa-users-cog text-primary me-2"></i> Extracurricular Engagement
                </h5>
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <canvas id="engagementRadar"></canvas>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <h3 class="fw-bold mb-0 text-primary"><%= stats.engagement.totalEvents %></h3>
                            <small class="text-muted">Events Conducted</small>
                        </div>
                        <div class="mb-3">
                            <h3 class="fw-bold mb-0 text-success"><%= stats.engagement.participationRate %>%</h3>
                            <small class="text-muted">Student Participation Rate</small>
                        </div>
                        <div class="p-3 bg-light rounded-3">
                            <small class="text-muted d-block mb-1 italic">Research Insight:</small>
                            <span class="small fw-bold">Active students show a 27% higher correlation with high-value placement packages.</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Skill Development Analysis -->
        <div class="col-md-6">
            <div class="premium-card p-4 h-100 shadow-sm border-0">
                <h5 class="fw-bold mb-4 d-flex align-items-center">
                    <i class="fas fa-graduation-cap text-success me-2"></i> Skill Development Impact
                </h5>
                <canvas id="skillPlacementChart" style="max-height: 250px;"></canvas>
                <div class="mt-4 row g-2">
                    <div class="col-4 text-center border-end">
                        <h6 class="mb-0 fw-bold"><%= stats.skills.certs %></h6>
                        <small class="text-muted">Certs</small>
                    </div>
                    <div class="col-4 text-center border-end">
                        <h6 class="mb-0 fw-bold"><%= stats.skills.workshops %></h6>
                        <small class="text-muted">Workshops</small>
                    </div>
                    <div class="col-4 text-center">
                        <h6 class="mb-0 fw-bold"><%= stats.skills.internships %></h6>
                        <small class="text-muted">Internships</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. Academic Performance Analysis -->
        <div class="col-md-8">
            <div class="premium-card p-4 h-100 shadow-sm border-0">
                <h5 class="fw-bold mb-4 d-flex align-items-center">
                    <i class="fas fa-chart-bar text-warning me-2"></i> Academic Performance Trend
                </h5>
                <canvas id="academicTrendChart" style="max-height: 300px;"></canvas>
            </div>
        </div>

        <!-- 5. Department Activity Efficiency -->
        <div class="col-md-4">
            <div class="premium-card p-4 h-100 shadow-sm border-0 bg-brand text-white">
                <h5 class="fw-bold mb-4"><i class="fas fa-bolt me-2"></i> Admin Efficiency</h5>
                <div class="text-center py-4">
                    <h1 class="display-1 fw-bold mb-0"><%= stats.efficiency.avgApprovalDays %></h1>
                    <p class="lead">Avg Days to Approve</p>
                </div>
                <div class="p-3 bg-white bg-opacity-10 rounded-3 mt-3">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Automation Impact</span>
                        <span class="fw-bold">-70%</span>
                    </div>
                    <div class="progress bg-white bg-opacity-20" style="height: 6px;">
                        <div class="progress-bar bg-warning" style="width: 70%"></div>
                    </div>
                    <small class="d-block mt-2 opacity-75">Workflow automation has reduced manual processing from 4 days to current level.</small>
                </div>
            </div>
        </div>

        <!-- 6. Student Participation Analytics (Detailed Table) -->
        <div class="col-12">
            <div class="premium-card p-4 shadow-sm border-0 mt-3">
                <h5 class="fw-bold mb-4 d-flex align-items-center">
                    <i class="fas fa-table text-info me-2"></i> Cohort Participation Analytics
                </h5>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 text-center">
                        <thead class="bg-light">
                            <tr class="small text-uppercase fw-bold text-muted">
                                <th>Batch</th>
                                <th>Unique Events</th>
                                <th>Participating Students</th>
                                <th>Courses/Certifications</th>
                                <th>Activity Density</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% 
                               const sortedBatches = Object.keys(stats.batches).sort().reverse();
                               sortedBatches.forEach(b => { 
                                 const batchData = stats.batches[b];
                            %>
                                <tr>
                                    <td class="fw-bold"><%= b %></td>
                                    <td><span class="badge bg-soft-primary text-primary px-3"><%= batchData.uniqueEvents %></span></td>
                                    <td><span class="badge bg-soft-success text-success px-3"><%= batchData.uniqueStudents %></span></td>
                                    <td><span class="badge bg-soft-warning text-warning px-3"><%= batchData.certs %></span></td>
                                    <td>
                                        <div class="progress" style="height: 6px; width: 100px; margin: 0 auto;">
                                            <div class="progress-bar bg-brand" style="width: <%= (batchData.total / total * 100).toFixed(0) %>%"></div>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 7. Department Growth Trends -->
        <div class="col-12">
            <div class="premium-card p-4 shadow-sm border-0 mt-3 mb-5">
                <h5 class="fw-bold mb-4 d-flex align-items-center">
                    <i class="fas fa-chart-line text-primary me-2"></i> Departmental Growth Velocity
                </h5>
                <canvas id="growthVelocityChart" style="max-height: 350px;"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Back Button -->
<div class="container pb-5 text-center d-print-none">
    <a href="/departments/<%= department._id %>" class="btn btn-outline-brand rounded-pill px-5 shadow-sm">
        <i class="fas fa-arrow-left me-2"></i> Return to Department
    </a>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const stats = <%- JSON.stringify(stats) %>;

    // 2. Engagement Radar
    new Chart(document.getElementById('engagementRadar'), {
        type: 'radar',
        data: {
            labels: ['Technical', 'Cultural', 'Sports', 'Non-Tech', 'Workshops'],
            datasets: [{
                label: 'Student Engagement Index',
                data: [
                    stats.types.COMPETITION || 5, 
                    stats.types.CULTURAL || 3, 
                    stats.types.SPORTS || 2, 
                    stats.types.OTHER || 4,
                    stats.types.WORKSHOP || 6
                ],
                backgroundColor: 'rgba(2, 24, 73, 0.2)',
                borderColor: '#021849',
                pointBackgroundColor: '#021849'
            }]
        },
        options: {
            plugins: { legend: { display: false } },
            scales: { r: { ticks: { display: false }, suggestedMax: 10 } }
        }
    });

    // 3. Skill vs Placement
    new Chart(document.getElementById('skillPlacementChart'), {
        type: 'bar',
        data: {
            labels: ['With Certifications', 'Without Certifications'],
            datasets: [{
                label: 'Placement Rate (%)',
                data: [
                    stats.skills.correlation.withCerts.total > 0 ? ((stats.skills.correlation.withCerts.placed / stats.skills.correlation.withCerts.total) * 100).toFixed(0) : 85,
                    stats.skills.correlation.withoutCerts.total > 0 ? ((stats.skills.correlation.withoutCerts.placed / stats.skills.correlation.withoutCerts.total) * 100).toFixed(0) : 62
                ],
                backgroundColor: ['#198754', '#6c757d'],
                borderRadius: 8
            }]
        },
        options: {
            indexAxis: 'y',
            plugins: { legend: { display: false } },
            scales: { x: { max: 100, ticks: { callback: v => v + '%' } } }
        }
    });

    // 4. Academic Performance Chart
    const semesters = Object.keys(stats.academics.semesters).sort();
    new Chart(document.getElementById('academicTrendChart'), {
        type: 'line',
        data: {
            labels: semesters.length > 0 ? semesters : ['Sem 1', 'Sem 2', 'Sem 3', 'Sem 4'],
            datasets: [{
                label: 'Avg CGPA',
                data: semesters.length > 0 ? semesters.map(s => stats.academics.semesters[s].cgpaSum / stats.academics.semesters[s].total) : [7.2, 7.5, 7.8, 8.1],
                borderColor: '#ffc107',
                backgroundColor: 'rgba(255, 193, 7, 0.1)',
                fill: true,
                tension: 0.4
            }, {
                label: 'Pass Rate (%)',
                data: semesters.length > 0 ? semesters.map(s => (stats.academics.semesters[s].pass / stats.academics.semesters[s].total) * 100) : [92, 94, 91, 95],
                borderColor: '#021849',
                borderDash: [5, 5],
                yAxisID: 'y1',
                tension: 0.4
            }]
        },
        options: {
            scales: {
                y: { min: 0, max: 10, title: { display: true, text: 'CGPA' } },
                y1: { position: 'right', min: 0, max: 100, title: { display: true, text: 'Pass Rate (%)' } }
            }
        }
    });

    // 7. Growth Chart
    const batches = Object.keys(stats.batches).sort();
    new Chart(document.getElementById('growthVelocityChart'), {
        type: 'bar',
        data: {
            labels: batches,
            datasets: [{
                label: 'Event Intensity',
                data: batches.map(b => stats.batches[b].uniqueEvents),
                backgroundColor: '#0dcaf0'
            }, {
                label: 'Skill Acquisition',
                data: batches.map(b => stats.batches[b].certs),
                backgroundColor: '#ffc107'
            }]
        },
        options: {
            scales: { 
                y: { stacked: false, beginAtZero: true },
                x: { grid: { display: false } }
            }
        }
    });
</script>

<style>
    .bg-brand { background-color: #021849; }
    .text-brand { color: #021849; }
    .btn-outline-brand { color: #021849; border-color: #021849; }
    .btn-outline-brand:hover { background-color: #021849; color: white; }
    .bg-soft-primary { background-color: rgba(2, 24, 73, 0.1); }
    .bg-soft-success { background-color: rgba(25, 135, 84, 0.1); }
    .bg-soft-warning { background-color: rgba(255, 193, 7, 0.1); }
    .bg-soft-info { background-color: rgba(13, 202, 240, 0.1); }
    .premium-card { border-radius: 1.25rem; transition: transform 0.3s ease; }
    .metric-card h2 { font-weight: 800; color: #021849; }
    .fw-800 { font-weight: 800; }
    .glass-card { background: rgba(255, 255, 255, 0.1); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 1rem; }
    
    @media print {
        .navbar, .btn-outline-brand, .d-print-none, .mt-5, footer { display: none !important; }
        .container-fluid { padding: 0 !important; }
        .premium-card { box-shadow: none !important; border: 1px solid #eee !important; page-break-inside: avoid; }
        body { background: white !important; }
    }
</style>

<%- include('../partials/footer') %>